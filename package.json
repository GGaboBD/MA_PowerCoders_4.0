{
  "name": "avianca-powercoders",
  "version": "2.0.0",
  "private": true,
  "description": "Sitio web Avianca Premium Concept: reservas de clientes, pase de abordar QR y panel de tripulación con dos bases MongoDB",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "node --env-file=.env backend/index.js",
    "preparar": "node --env-file-if-exists=.env backend/scripts/preparar-bases.js",
    "personal:crear": "node --env-file-if-exists=.env backend/scripts/crear-personal.js",
    "demo": "node --env-file-if-exists=.env backend/scripts/semilla-demo.js",
    "seed": "node --env-file-if-exists=.env seed.js",
    "seed:noviembre": "node --env-file-if-exists=.env backend/scripts/semilla-noviembre.js",
    "seed:red-paises": "node --env-file-if-exists=.env backend/scripts/sembrar-red-paises.js",
    "check:syntax": "node scripts/revisar-sintaxis.js",
    "test:cabina": "node --test tests/cabina-requerimientos.test.js",
    "test:preferencias": "node --test tests/preferencias-conexiones-offline.test.js",
    "test:sprint4": "node --test tests/suite-sprint4-completa.test.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
