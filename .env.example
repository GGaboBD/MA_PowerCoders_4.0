# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# Base de clientes (la que ya existe en MongoDB Atlas): cuentas de clientes, sesiones de clientes,
# vuelos, reservas, boletos, pasajeros, preferencias y perfiles de atención.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=avianca

# Base de Avianca (nueva y separada): cuentas del personal (azafatas y administradores),
# sus sesiones, el registro de abordaje y la auditoría. Debe tener otro nombre.
# Si MONGODB_URI_AVIANCA queda vacía se usa el mismo clúster de MONGODB_URI.
# Si MONGODB_DB_AVIANCA queda vacía se usará por defecto "${MONGODB_DB}_operaciones".
MONGODB_URI_AVIANCA=
MONGODB_DB_AVIANCA=avianca_operaciones

PORT=3000
# En producción: dirección https pública del sitio (en Render basta con RENDER_EXTERNAL_URL).
PUBLIC_ORIGIN=

# Opcional: contraseña de las cuentas creadas por npm run demo o npm run personal:crear (15 a 128 caracteres).
DEMO_PASSWORD=
PERSONAL_PASSWORD=
