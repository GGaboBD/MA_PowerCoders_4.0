# ==============================================================================
# Variables de entorno para Vercel y desarrollo local
# En Vercel: Configurar en Settings > Environment Variables
# En local: Copiar como .env (no commitear el archivo .env)
# ==============================================================================

# 1. Conexión principal a MongoDB Atlas (OBLIGATORIA):
# URI de conexión proporcionada por MongoDB Atlas.
# Ejemplo: mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# 2. Base de datos principal de clientes (OPCIONAL, por defecto: avianca):
# Contiene usuarios clientes, reservas, vuelos y boletos.
MONGODB_DB=avianca

# 3. Base de datos de operaciones/Avianca (OPCIONAL, por defecto: ${MONGODB_DB}_operaciones):
# Contiene el personal (azafatas, administradores), sesiones y registro de abordaje.
# Si MONGODB_URI_AVIANCA se deja vacía, se utiliza el mismo clúster de MONGODB_URI.
MONGODB_URI_AVIANCA=
MONGODB_DB_AVIANCA=avianca_operaciones

# 4. Origen público (OPCIONAL en Vercel, útil para CORS y cookies seguras):
# En producción: https://powercoders.vercel.app
PUBLIC_ORIGIN=https://powercoders.vercel.app

# 5. Puerto local (solo para ejecución con 'npm start' o 'npm run dev', Vercel lo omite):
PORT=3000

# 6. Contraseñas administrativas opcionales para scripts demo/personal:
DEMO_PASSWORD=
PERSONAL_PASSWORD=
